---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: `${base}/projects`, label: 'Projects' },
  { href: `${base}/blog`, label: 'Blog' },
  { href: `${base}/talks`, label: 'Talks' },
  { href: `${base}/resume`, label: 'Resume' },
];
---

<nav class="border-b border-border-dark light:border-border-light">
  <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <!-- Left: home link + nav links -->
    <div class="flex items-center gap-8">
      <a
        href={`${base}/`}
        class="text-sm font-bold text-text-dark light:text-text-light hover:opacity-70 transition-opacity"
      >
        BB
      </a>
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="nav-link text-sm font-medium text-muted-dark light:text-muted-light hover:text-text-dark light:hover:text-text-light transition-colors relative"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right: social icons + theme toggle -->
    <div class="flex items-center gap-3">
      <!-- GitHub -->
      <a
        href="https://github.com/baukebrenninkmeijer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-muted-dark light:text-muted-light hover:text-text-dark light:hover:text-text-light transition-colors"
      >
        <Icon name="github" size={20} />
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/baukebrenninkmeijer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-muted-dark light:text-muted-light hover:text-text-dark light:hover:text-text-light transition-colors"
      >
        <Icon name="linkedin" size={20} />
      </a>

      <ThemeToggle />
    </div>
  </div>
</nav>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.2s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }
</style>
