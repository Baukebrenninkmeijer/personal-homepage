---
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-border-dark light:border-border-light">
  <div class="max-w-5xl mx-auto px-6 h-12 flex items-center justify-between">
    <!-- Left: copyright -->
    <p class="text-xs text-muted-dark light:text-muted-light m-0">
      &copy; {year} Bauke Brenninkmeijer
    </p>

    <!-- Right: social icons (smaller) -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/baukebrenninkmeijer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-muted-dark hover:text-text-dark light:text-muted-light light:hover:text-text-light transition-colors"
      >
        <Icon name="github" />
      </a>

      <a
        href="https://linkedin.com/in/baukebrenninkmeijer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-muted-dark hover:text-text-dark light:text-muted-light light:hover:text-text-light transition-colors"
      >
        <Icon name="linkedin" />
      </a>
    </div>
  </div>
</footer>
