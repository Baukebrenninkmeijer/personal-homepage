---
interface Props {
  name: 'github' | 'linkedin' | 'globe' | 'mail';
  size?: number;
  class?: string;
}

import { paths } from '../data/icons';

const { name, size = 16, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <path d={paths[name]} />
</svg>
