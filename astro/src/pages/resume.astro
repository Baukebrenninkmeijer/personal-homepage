---
import Layout from '../layouts/Layout.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import { experience, volunteering, education, publications } from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

---

<Layout
  title="Resume"
  description="Work experience, education, and background of Bauke Brenninkmeijer — AI Research Engineer and Data Scientist."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-10">
      <h1 class="text-3xl font-bold text-text-dark light:text-text-light">Resume</h1>
      <a
        class=""
        href={`${base}/CV_Bauke_Brenninkmeijer.pdf`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs border border-border-dark light:border-border-light rounded px-3 py-1.5 text-muted-dark light:text-muted-light hover:border-muted-dark light:hover:border-muted-light hover:text-text-dark light:hover:text-text-light transition-colors"
      >
        Download PDF
      </a>
    </div>

    <section class="mb-12">
      <h2 class="text-lg font-bold text-text-dark light:text-text-light mb-4 pb-2 border-b border-border-dark light:border-border-light">
        Experience
      </h2>
      <div>
        {experience.map((entry) => (
          <TimelineEntry
            company={entry.company}
            role={entry.role}
            period={entry.period}
            bullets={entry.bullets}
          />
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-lg font-bold text-text-dark light:text-text-light mb-4 pb-2 border-b border-border-dark light:border-border-light">
        Volunteering
      </h2>
      <div>
        {volunteering.map((entry) => (
          <TimelineEntry
            company={entry.company}
            role={entry.role}
            period={entry.period}
            bullets={entry.bullets}
          />
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-lg font-bold text-text-dark light:text-text-light mb-4 pb-2 border-b border-border-dark light:border-border-light">
        Education
      </h2>
      <div>
        {education.map((entry) => (
          <TimelineEntry
            company={entry.company}
            role={entry.role}
            period={entry.period}
            bullets={entry.bullets}
          />
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-lg font-bold text-text-dark light:text-text-light mb-4 pb-2 border-b border-border-dark light:border-border-light">
        Publications
      </h2>
      <ul class="flex flex-col gap-3">
        {publications.map((pub) => (
          <li class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-4">
            <span class="text-xs text-muted-dark light:text-muted-light md:w-36 shrink-0">{pub.year}</span>
            <div class="flex flex-col gap-0.5">
              <a
                href={pub.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-text-dark light:text-text-light hover:underline"
              >
                {pub.title}
              </a>
              <span class="text-xs text-muted-dark light:text-muted-light">{pub.venue}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
