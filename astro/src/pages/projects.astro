---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const otherProjects = [
  {
    title: 'table-evaluator',
    description:
      'Open-source Python library for evaluating how well synthetic datasets match real data. Measures statistical similarity, distributions, and correlations between real and generated tabular datasets.',
    tags: ['Python', 'PyPI', 'Open Source'],
    links: [
      { label: 'GitHub', href: 'https://github.com/baukebrenninkmeijer/table-evaluator' },
      { label: 'PyPI', href: 'https://pypi.org/project/table-evaluator/' },
    ],
  },
  {
    title: 'Building the Evaluation Flywheel',
    description:
      'Companion repo for the PyData Amsterdam 2026 talk. A data-analysis agent answers 50 business cases, a jury of LLM judges flags where it disagrees, and a human\u2019s answers to those boundary questions become a pass/fail evaluator.',
    tags: ['Python', 'LLMs', 'Evaluation'],
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/Baukebrenninkmeijer/building-the-evaluation-flywheel-pydata-2026',
      },
    ],
  },
  {
    title: 'FakeFynder',
    description:
      'Website that checks videos for manipulated areas, built as a proof of concept at the Hackathon for Good in The Hague, 2019.',
    tags: ['Python', 'Deepfakes', 'Computer Vision'],
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/Baukebrenninkmeijer/FakeFynder-Hackathon-for-Good-2019',
      },
    ],
  },
  {
    title: 'Master Thesis — Synthetic Tabular Data with GANs',
    description:
      'Research on improving Generative Adversarial Networks for tabular data generation and evaluation.',
    tags: ['Python', 'GANs', 'Research'],
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/baukebrenninkmeijer/On-the-Generation-and-Evaluation-of-Synthetic-Tabular-Data-using-GANs',
      },
      {
        label: 'Thesis PDF',
        href: 'https://www.cs.ru.nl/masters-theses/2019/B_Brenninkmeijer___On_the_generation_and_evaluation_of_tabular_data_using_GANs.pdf',
      },
    ],
  },
  {
    title: 'OpenClaw',
    description:
      'Open-source project at orq.ai for AI agent development and orchestration.',
    tags: ['Open Source'],
    links: [{ label: 'GitHub', href: 'https://github.com/orq-ai/openclaw' }],
  },
  {
    title: 'Context is King',
    description:
      'PyData Amsterdam 2025 project exploring long context windows vs RAG for document understanding.',
    tags: ['Python', 'LLMs', 'RAG'],
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/Baukebrenninkmeijer/pydata-2025-context-is-king',
      },
    ],
  },
];
---

<Layout
  title="Projects"
  description="Open-source projects, research, and software built by Bauke Brenninkmeijer."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-10 text-text-dark light:text-text-light">Projects</h1>

    <!-- Featured project: pigeonhole -->
    <div class="mb-10 border border-border-dark light:border-border-light rounded-xl overflow-hidden flex flex-col sm:flex-row hover:-translate-y-0.5 hover:border-muted-dark light:hover:border-muted-light transition-all">
      <div class="p-8 flex-1">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <p class="text-xs uppercase tracking-widest text-muted-dark light:text-muted-light">Featured Project</p>
        </div>
        <h2 class="text-2xl font-bold text-text-dark light:text-text-light mb-3">pigeonhole</h2>
        <p class="text-base text-muted-dark light:text-muted-light leading-relaxed max-w-2xl mb-5">
          A wall of mail slots for coding agents running in parallel. Each git worktree gets a pigeonhole; agents post what they are working on and leave each other notes, and read the board at session start. No server, no daemon, no MCP &mdash; one POSIX shell script and the filesystem.
        </p>
        <div class="flex flex-wrap gap-2 mb-5">
          {['Shell', 'AI Agents', 'Open Source'].map((tag) => (
            <span class="text-xs border border-border-dark light:border-border-light rounded-full px-3 py-1 text-muted-dark light:text-muted-light">{tag}</span>
          ))}
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/Baukebrenninkmeijer/pigeonhole"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg text-sm font-semibold bg-text-dark text-bg-dark light:bg-text-light light:text-bg-light hover:opacity-80 transition-opacity"
          >
            GitHub
          </a>
        </div>
      </div>
      <div class="sm:w-2/5 sm:shrink-0 bg-[#1f1b16] flex items-center border-t sm:border-t-0 sm:border-l border-border-dark light:border-border-light">
        <img
          src="/projects/pigeonhole.svg"
          alt="A 3x3 wall of mail slots, one holding a note, above a terminal showing the pigeonhole session-start message"
          width="640"
          height="640"
          class="w-full h-auto"
        />
      </div>
    </div>

    <!-- Other projects -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {otherProjects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tags={project.tags}
          links={project.links}
        />
      ))}
    </div>
  </div>
</Layout>
